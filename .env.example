NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/notification-service

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_PREFIX=notification-service

LOG_LEVEL=info

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Socket.IO (WebSocket) real-time notifications
WS_NAMESPACE=notifications
# Comma-separated list of allowed origins. Use * to allow all.
WS_CORS_ORIGIN=*
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=60000
WS_REDIS_ADAPTER=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=your-email-password
MAIL_SECURE=false
EMAIL_FROM=example@gmail.com